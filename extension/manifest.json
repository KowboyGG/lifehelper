{
  "manifest_version": 3,
  "name": "LifeHelper — сначала дело",
  "short_name": "LifeHelper",
  "version": "1.1.0",
  "description": "Не пускает на YouTube и TikTok, пока не сделано главное. Считает время на учёбу и отвлечения.",
  "permissions": ["storage", "alarms", "tabs", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LifeHelper",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
