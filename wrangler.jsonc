{
  // Cloudflare Worker: API + Telegram-бот + крон + раздача сайта (web/dist)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifehelper",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/tg/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // id не нужен: при первом `wrangler deploy` база создастся сама,
      // а таблицы воркер создаст при первом запросе (worker/lib/schema.ts)
      "database_name": "lifehelper",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": { "enabled": true }
}
